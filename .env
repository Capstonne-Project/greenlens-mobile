# Backend GreenLens — có prefix /v1
#
# Máy dev (Expo web / iOS Simulator): localhost thường OK.
# Android Emulator: BẮT BUỘC dùng 10.0.2.2 thay localhost:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5162/v1a
# Điện thoại thật (USB hoặc cùng WiFi): IP LAN máy chạy API, ví dụ:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:5162/v1
#

# 192.168.137.1 — Mobile Hotspot adapter (Windows tạo ra khi bật hotspot từ máy tính)
# 172.20.10.2 — IP máy tính nhận từ hotspot điện thoại

# 192.168.137.30
EXPO_PUBLIC_API_URL=https://api.greenlens.online/v1

# EXPO_PUBLIC_API_URL=http://192.168.1.9:5162/v1
# EXPO_PUBLIC_API_URL=http://192.168.88.57:5162/v1
# EXPO_PUBLIC_API_URL=http://192.168.100.9:5162/v1
# EXPO_PUBLIC_API_URL=http://192.168.1.30:5162/v1
# EXPO_PUBLIC_API_URL=http://192.168.137.1:5162/v1
EXPO_PUBLIC_GOONG_API_KEY=0jtycwk7gRBzrn87QleU9Gaxs9W0Uu6ILyBfKEcJ

# Goong Maptiles Key — khác với REST API Key ở trên (Goong cấp riêng 2 key).
# Dùng để load style URL cho bản đồ nền (MapLibre) — xem docs.goong.io/maptiles
EXPO_PUBLIC_GOONG_MAPTILES_KEY=QFOH0fqODdxAsqHcT5em2fX07GUjJIlsZWzkoNzq

# ── Google Sign-In — Firebase project: greenlens-app ──
# Cần development build (không chạy trên Expo Go). Xem docs/fe-google-signin-setup.md
# Lấy giá trị theo hướng dẫn: docs/fe-google-signin-setup.md
# Để trống thì nút Google báo "chưa được cấu hình" (không crash).

# Firebase Console → Project settings → General → "Web API Key"
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAyKQQxxRVz0_8x2IJuA2B2NyJMqbqOGL0

# Google Cloud Console → APIs & Services → Credentials
# → OAuth 2.0 Client IDs → client loại "Web application"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=472273559472-fv8jeutieutom5vqjqr3dlou9tktfuj6.apps.googleusercontent.com

# Chỉ cần khi build standalone (Expo Go không dùng đến)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=