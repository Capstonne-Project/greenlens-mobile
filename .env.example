# Sao chép thành `.env` và điền giá trị (không commit `.env`).

# Base URL API — có suffix /v1 (xem src/services/api.ts)
EXPO_PUBLIC_API_URL=

# (Tuỳ chọn) Goong REST API key — Geocode / Directions / Places khi tích hợp HTTP; không bắt buộc cho map nền.
# Cũng dùng cho Direction API (vẽ tuyến đường đi bộ trong dialog check-in ngoài phạm vi).
# EXPO_PUBLIC_GOONG_API_KEY=

# ── Google Sign-In (POST /auth/google-login) ──
# Xem hướng dẫn lấy từng giá trị: docs/fe-google-signin-setup.md
# Thiếu WEB_CLIENT_ID hoặc FIREBASE_API_KEY thì nút Google báo "chưa được cấu hình".

# OAuth client loại "Web application" của Firebase project.
# Dùng cho Expo Go, và làm audience khi đổi token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Web API key (Project settings → General → Web API Key).
# Cần để đổi token Google → Firebase ID token, vì BE verify bằng Firebase Admin SDK.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Chỉ cần khi chạy trên development/production build (không cần cho Expo Go).
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
